# SlothSec Environment Configuration
# All configurations are local-first and zero-cost.

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (SQLite local file)
DATABASE_URL=sqlite:///./slothsec.db

# AI Provider Configuration (Ollama Local)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=90

# Scanner Executable Paths (defaults assume binaries are in PATH)
SEMGREP_BIN=semgrep
OSV_SCANNER_BIN=osv-scanner
GITLEAKS_BIN=gitleaks

# Scan Limits & Timeouts (seconds)
SCAN_TIMEOUT_SECONDS=300

# Observability Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=slothsec-engine

# Optional Sentry (disabled by default; zero-cost local operation remains 100% functional)
SENTRY_DSN=
SENTRY_ENABLED=false
